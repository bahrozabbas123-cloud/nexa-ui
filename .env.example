# Frontend environment configuration example for NexaUI.
# Copy this file to `.env.local` for local development.

# Base URL of the NexaUI backend API (no trailing slash).
# This value is inlined into the client bundle at build time, so it must be set
# BEFORE running `npm run build` in CI/production. Falls back to
# http://localhost:5000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:5000
